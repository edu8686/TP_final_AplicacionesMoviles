<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beigeclaro"
    tools:context=".MoneyConvertor">

    <!-- Título -->
    <TextView
        android:id="@+id/textoinicial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Conversor de Monedas"
        android:textSize="24sp"
        android:textColor="@color/backgreen"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Primera fila: Moneda origen + Monto -->
    <Spinner
        android:id="@+id/spinnerMonedaOrigen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/inputCurrency1"
        app:layout_constraintTop_toBottomOf="@id/textoinicial"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="24dp"
        app:layout_constraintWidth_percent="0.35"/>

    <EditText
        android:id="@+id/inputCurrency1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Monto"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintStart_toEndOf="@id/spinnerMonedaOrigen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinnerMonedaOrigen"
        app:layout_constraintBottom_toBottomOf="@id/spinnerMonedaOrigen"
        app:layout_constraintWidth_percent="0.55"/>

    <!-- Segunda fila: Moneda destino + Monto -->
    <Spinner
        android:id="@+id/spinnerMonedaDestino"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/inputCurrency2"
        app:layout_constraintTop_toBottomOf="@id/spinnerMonedaOrigen"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="24dp"
        app:layout_constraintWidth_percent="0.35"/>

    <EditText
        android:id="@+id/inputCurrency2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Monto"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textSize="16sp"
        android:singleLine="true"
        app:layout_constraintStart_toEndOf="@id/spinnerMonedaDestino"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/spinnerMonedaDestino"
        app:layout_constraintBottom_toBottomOf="@id/spinnerMonedaDestino"
        app:layout_constraintWidth_percent="0.55"/>



</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beigeclaro"
    tools:context=".SecondActivity">

<!--    ******* CAMBIOS CANDE ******* -->

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué querés hacer hoy?"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        app:cornerRadius="20dp"
        android:textStyle="bold"
        android:background="@color/beigeclaro"
        android:padding="10dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConversor"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="160dp"
        android:backgroundTint="@android:color/white"
        android:elevation="8dp"
        android:text="Conversor"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:translationZ="4dp"
        app:cornerRadius="20dp"
        app:icon="@drawable/conversor"
        app:iconGravity="top"
        app:iconPadding="10dp"
        app:iconSize="90dp"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCotizaciones"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginLeft="160dp"
        android:layout_marginTop="180dp"
        android:backgroundTint="@color/white"
        android:elevation="8dp"
        android:text="Cotizaciones"
        android:textColor="@android:color/black"
        android:translationZ="4dp"
        app:cornerRadius="20dp"
        app:icon="@drawable/cotizaciones"
        app:iconGravity="top"
        app:iconPadding="10dp"
        app:iconSize="85dp"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.549"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDndComprar"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginLeft="160dp"
        android:layout_marginTop="360dp"
        android:backgroundTint="@color/white"
        android:elevation="400dp"
        android:text="Dónde comprar"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:translationZ="4dp"
        app:cornerRadius="20dp"
        app:icon="@drawable/compra"
        app:iconGravity="top"
        app:iconPadding="3dp"
        app:iconSize="78dp"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.549"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistorial"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="360dp"
        android:layout_marginRight="160dp"
        android:backgroundTint="@color/white"
        android:elevation="8dp"
        android:text="Historial"
        android:textColor="@android:color/black"
        android:translationZ="4dp"
        app:cornerRadius="20dp"
        app:icon="@drawable/historial"
        app:iconGravity="top"
        app:iconPadding="10dp"
        app:iconSize="90dp"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!--********************************************-->



</androidx.constraintlayout.widget.ConstraintLayout>